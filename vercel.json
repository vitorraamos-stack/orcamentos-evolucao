{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/hub-os",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/hub-os/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/os-detail-uxui-integrated-20261030": false,
      "feat/dashboard-inteligencia-avancada-etapa4-20261106": false,
      "feat/dashboard-operacional-politicas-etapa1-20261109": false,
      "feat/os-detail-layout-fullwidth-scroll-20261110": false,
      "feat/os-header-compact-20261110": false,
      "feat/os-clean-header-remove-visual-reference-20261110": false,
      "feat/os-summary-products-first-highlight-20261110": false,
      "feat/os-summary-deadlines-first-20261110": false,
      "feat/os-overview-subtle-gray-dark-20261110": false,
      "feat/os-summary-art-briefing-card-20261110": false,
      "feat/os-summary-section-headers-1c2935-20261110": false,
      "feat/pwa-evolusystem-20261110": false,
      "feat/pwa-v2-mobile-install-updates-20261110": false,
      "feat/pwa-v3-mobile-navigation-20261110": false,
      "feat/pwa-v4-notificacoes-etapa1-20261110": false,
      "feat/pwa-v4-push-schema-security-20261111": false,
      "feat/pwa-v4-server-subscriptions-20261111": false,
      "feat/pwa-v4-consent-ui-20261111": false,
      "feat/pwa-v4-event-engine-dispatch-20261111": false,
      "feat/pwa-v4-release-readiness-20261111": false
    }
  }
}
